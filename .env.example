# Local deterministic mode needs no credentials. Never commit .env.local.
OPENAI_API_KEY=<SECRET_FROM_APPROVED_STORE>
METRICPILOT_ENABLE_LIVE=0
METRICPILOT_TOTAL_CAP_USD=5
METRICPILOT_DAILY_CAP_USD=1
# Local runs use the persistent SQLite ledger. Leave both Redis variables UNSET.
# Public live mode requires both shared-quota secrets; uncomment only to configure it.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
METRICPILOT_CLIENT_SALT=
# Local Next.js -> FastAPI proxy; unset for Vercel's same-project Python routes.
METRICPILOT_API_URL=http://127.0.0.1:8000
